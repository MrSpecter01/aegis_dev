# Aegis Infrastructure — Environment Configuration Template
# Copy this file to `deploy/.env` (or project root `.env`) and adjust as needed.
#
# =============================================================================
# 1. DOCKER COMPOSE PROFILES
# =============================================================================
# Controls which service tiers start when running `docker compose up -d`:
#
# - "" (empty / default)   : Core services only (Redis, Qdrant, Grafana).
#                            Production mode — assumes external telemetry.
# - "monitoring"           : Core + local LGTM stack (Prometheus, Alertmanager, Loki, Tempo).
#                            Dev / demo mode — self-contained sandbox.
# - "monitoring,ollama"    : Core + local LGTM + Dockerized Ollama container.
#                            CI / clean-machine mode where local Ollama is absent.
#
COMPOSE_PROFILES=monitoring

# =============================================================================
# 2. OBSERVABILITY / TELEMETRY ENDPOINTS (FOR GRAFANA & MCP SERVERS)
# =============================================================================
# When running with COMPOSE_PROFILES=monitoring, leave these as the local service defaults.
# In production, point these to your target Kubernetes / monitoring cluster endpoints.
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200

# =============================================================================
# 3. LLM SERVING (OLLAMA / CLOUD)
# =============================================================================
# Local host Ollama endpoint:
# - If running Aegis services directly on host: http://localhost:11434
# - If running Aegis services inside Docker containers: http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
GOOGLE_API_KEY=your-google-api-key-here

# =============================================================================
# 4. GRAFANA OPERATOR DASHBOARD CREDENTIALS
# =============================================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# =============================================================================
# 5. CONTROL PLANE, MULTI-ENTITY API KEYS & HITL NOTIFICATIONS
# =============================================================================
AEGIS_API_KEY=aegis-secret-key-dev
AEGIS_ADMIN_TELEGRAM_ID=
AEGIS_ALERTMANAGER_API_KEY=aegis-alertmanager-key-dev
# Optional per-operator / external client keys referenced in config/identities.yaml:
# AEGIS_OPERATOR_JOHN_DOE_KEY=replace-with-strong-random-key
# AEGIS_OPERATOR_JOHN_DOE_TELEGRAM_ID=
# AEGIS_EXT_CLIENT_KEY=replace-with-strong-random-key
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# 6. MCP EXTERNAL PLATFORMS & CLUSTER INTEGRATIONS
# =============================================================================
KUBECONFIG_PATH=/app/deploy/kubeconfig
KUBERNETES_URL=
KUBERNETES_TOKEN=
ARGOCD_URL=
ARGOCD_TOKEN=
GITHUB_TOKEN=
# Optional outbound auth tokens when Prometheus/Loki/Tempo/Jaeger/Flagd are external:
PROMETHEUS_API_KEY=
LOKI_API_KEY=
TEMPO_API_KEY=
JAEGER_API_KEY=
FLAGD_API_KEY=

# =============================================================================
# 7. HOST PORT OVERRIDES (RESOLVE CONFLICTS WITH HOST/EXTERNAL SERVICES)
# =============================================================================
# Adjust any port here if you have local services (e.g., Jenkins on 8080, Grafana on 3000,
# local Redis on 6379, Portainer on 9000, or kubectl port-forwarding):
# AEGIS_API_PORT=8080
# AEGIS_DASHBOARD_PORT=3000
# AEGIS_MCP_PORT=9000
# TOPOLOGY_MCP_PORT=9008
# GRAFANA_PORT=3001
# REDIS_PORT=6379
# QDRANT_PORT=6333
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# LOKI_PORT=3100
# TEMPO_PORT=3200
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318
# OLLAMA_PORT=11434

