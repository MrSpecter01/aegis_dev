# =============================================================================
# Aegis — MCP Server Registry Template (mcp.yaml.example)
# Copy this file to config/mcp.yaml and customize for your deployment architecture.
#
# Execution Modes:
# 1. Unified Server (Default, port 9000):
#    Point all servers to http://aegis-mcp:9000/mcp (or http://localhost:9000/mcp).
# 2. Isolated Containers (Profile: mcp-isolated, ports 9001-9008):
#    Point each domain to its dedicated port as shown below.
# =============================================================================

mcp_servers:
  prometheus:
    server_url: "http://aegis-prometheus-mcp:9001/mcp"
    tools:
      - prometheus_query

  loki:
    server_url: "http://aegis-loki-mcp:9002/mcp"
    tools:
      - loki_query

  tempo:
    server_url: "http://aegis-tempo-mcp:9003/mcp"
    tools:
      - tempo_get_trace
      - tempo_search

  kubernetes:
    server_url: "http://aegis-k8s-mcp:9004/mcp"
    tools:
      - k8s_get_events
      - k8s_get_pod_status
      - k8s_get_node_metrics
      - k8s_get_configmap_diff
      - restart_pod
      - scale_deployment
      - rollback_release
      - update_resource_limits
      - drain_node

  argocd:
    server_url: "http://aegis-argocd-mcp:9005/mcp"
    tools:
      - argocd_get_sync_history
      - argocd_get_app_status

  github:
    server_url: "http://aegis-github-mcp:9006/mcp"
    tools:
      - github_get_commits

  featureflags:
    server_url: "http://aegis-api:9007/mcp"
    tools:
      - toggle_feature_flag

  qdrant:
    server_url: "http://aegis-mcp:9000/mcp"
    tools:
      - qdrant_search

  topology:
    server_url: "http://aegis-topology-mcp:9008/mcp"
    tools:
      - topology_query_node

# -----------------------------------------------------------------------------
